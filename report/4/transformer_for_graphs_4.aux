\@writefile{toc}{\contentsline {section}{\numberline {3}Thread 1: what makes a graph hard --- the diameter and the density}{3}{section.3}\protected@file@percent }
\newlabel{sec:diff}{{3}{3}{Thread 1: what makes a graph hard --- the diameter and the density}{section.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}How accuracy depends on distance: the capacity wall}{3}{subsection.3.1}\protected@file@percent }
\newlabel{sec:diffmap}{{3.1}{3}{How accuracy depends on distance: the capacity wall}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Accuracy on connected pairs vs the shortest-path distance between the two nodes. \emph  {Model:} the standard transformer ($L=2$, $d_{\mathrm  {model}}=512$, single head, \emph  {linear} read-out) trained on \emph  {ER only} --- $\mathrm  {ER}(20,0.08)$ at $n=20$ ($8$ seeds, left) and $\mathrm  {ER}(40,0.05)$ at $n=40$ ($4$ seeds, right). \emph  {Test set:} the held-out \textbf  {chain\_plus} family (a long path plus a small separate component), which the model never saw in training; we use it because it contains pairs at every distance. Each line is the mean over the seeds, the band $\pm 1$ std. Perfect up to the capacity $3^L=9$, then a drop; the $n=20$ band is wide because of the seed lottery (per-seed in Section~\ref {sec:perseed}), the $n=40$ curves are tighter.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:accdist}{{2}{4}{Accuracy on connected pairs vs the shortest-path distance between the two nodes. \emph {Model:} the standard transformer ($L=2$, $d_{\mathrm {model}}=512$, single head, \emph {linear} read-out) trained on \emph {ER only} --- $\mathrm {ER}(20,0.08)$ at $n=20$ ($8$ seeds, left) and $\mathrm {ER}(40,0.05)$ at $n=40$ ($4$ seeds, right). \emph {Test set:} the held-out \textbf {chain\_plus} family (a long path plus a small separate component), which the model never saw in training; we use it because it contains pairs at every distance. Each line is the mean over the seeds, the band $\pm 1$ std. Perfect up to the capacity $3^L=9$, then a drop; the $n=20$ band is wide because of the seed lottery (per-seed in Section~\ref {sec:perseed}), the $n=40$ curves are tighter}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Density also matters, and it is a separate effect}{4}{subsection.3.2}\protected@file@percent }
\newlabel{sec:density}{{3.2}{4}{Density also matters, and it is a separate effect}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Whole-graph exact-match vs mean degree (density). \emph  {Same model as Figure~\ref {fig:accdist}} (standard, linear read-out, ER-trained; $n=20$ over $8$ seeds, $n=40$ over $4$ seeds, mean $\pm 1$ std). \emph  {Test set:} a purpose-built pool of single-component graphs (the difficulty-map pool: an ER density sweep, a random-regular degree sweep, barbells, chains and cycles), here restricted to small diameter ($\le 6$) so the density effect is isolated from the capacity wall. Both models do well near their training density (dotted lines) and fail on denser graphs; the sparser-trained $n=40$ model collapses almost immediately.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:accdens}{{3}{5}{Whole-graph exact-match vs mean degree (density). \emph {Same model as Figure~\ref {fig:accdist}} (standard, linear read-out, ER-trained; $n=20$ over $8$ seeds, $n=40$ over $4$ seeds, mean $\pm 1$ std). \emph {Test set:} a purpose-built pool of single-component graphs (the difficulty-map pool: an ER density sweep, a random-regular degree sweep, barbells, chains and cycles), here restricted to small diameter ($\le 6$) so the density effect is isolated from the capacity wall. Both models do well near their training density (dotted lines) and fail on denser graphs; the sparser-trained $n=40$ model collapses almost immediately}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}The spectral gap: we cannot separate it from the diameter}{5}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Where the test graphs sit in the (diameter, gap) plane ($n=20$; $n=40$ looks the same, correlation $-0.82$). Only \emph  {connected} graphs are shown, because the diameter and the spectral gap are only defined for a single component --- the disconnected families are made of these same pieces (a 2-chain is two paths, a 2-clique two cliques, a 2-cycle two cycles). ER, random-regular/expander and barbell are each swept over a parameter (edge probability, degree, clique size), so they form clouds; 1chain, 1cycle and a single clique are one fixed graph each at $n=20$, hence one marker apiece. Everything except the barbell lies on one descending diagonal ridge (clique $\to $ ER/expander $\to $ 1cycle $\to $ 1chain): a larger diameter comes with a smaller gap, with nothing in the ``large diameter \emph  {and} large gap'' corner, so the two cannot be told apart. Only the barbell (red) sits below the ridge --- a moderate diameter at a tiny gap --- and it gets there only by being locally dense (its two cliques).}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:collinear}{{4}{6}{Where the test graphs sit in the (diameter, gap) plane ($n=20$; $n=40$ looks the same, correlation $-0.82$). Only \emph {connected} graphs are shown, because the diameter and the spectral gap are only defined for a single component --- the disconnected families are made of these same pieces (a 2-chain is two paths, a 2-clique two cliques, a 2-cycle two cycles). ER, random-regular/expander and barbell are each swept over a parameter (edge probability, degree, clique size), so they form clouds; 1chain, 1cycle and a single clique are one fixed graph each at $n=20$, hence one marker apiece. Everything except the barbell lies on one descending diagonal ridge (clique $\to $ ER/expander $\to $ 1cycle $\to $ 1chain): a larger diameter comes with a smaller gap, with nothing in the ``large diameter \emph {and} large gap'' corner, so the two cannot be told apart. Only the barbell (red) sits below the ridge --- a moderate diameter at a tiny gap --- and it gets there only by being locally dense (its two cliques)}{figure.caption.6}{}}
