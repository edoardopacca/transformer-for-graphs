\newlabel{tab:byd_pu_n20}{{9}{11}{\textbf {path\_union}, $n=20$: \emph {whole-graph} exact-match as a function of the graph's diameter, per seed. Mixed: $1.00$ to diameter $9$, a dip over $10$--$13$, recovery by $16$. ER-trained: the same shape on the generalising seeds, flat $0$ on the rest}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {path\_union}, $n=40$: whole-graph exact-match by graph diameter, per seed. The wall is wide (near $0$ from diameter $10$ to $\sim 33$); the recovery appears only at the largest diameters (a single $39$-node path, which the mixed model gets entirely right).}}{11}{table.caption.22}\protected@file@percent }
\newlabel{tab:byd_pu_n40}{{10}{11}{\textbf {path\_union}, $n=40$: whole-graph exact-match by graph diameter, per seed. The wall is wide (near $0$ from diameter $10$ to $\sim 33$); the recovery appears only at the largest diameters (a single $39$-node path, which the mixed model gets entirely right)}{table.caption.22}{}}
