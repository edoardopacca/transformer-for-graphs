\@writefile{toc}{\contentsline {section}{\numberline {5}Thread 3: the read-out --- can a different head push the wall out?}{17}{section.5}\protected@file@percent }
\newlabel{sec:readout}{{5}{17}{Thread 3: the read-out --- can a different head push the wall out?}{section.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}The similarity read-out doubles the reach radius}{18}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Where it helps.}{18}{section*.32}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces \textbf  {$n=40$, mixed training}: whole-graph exact-match per seed, linear vs.\ similarity read-out, on the families where the two differ. The similarity read-out helps the long-range families and not the bottleneck (barbell) or 1cycle (distance $20>2\cdot 3^L=18$).}}{18}{table.caption.33}\protected@file@percent }
\newlabel{tab:simlin_n40}{{19}{18}{\textbf {$n=40$, mixed training}: whole-graph exact-match per seed, linear vs.\^^Msimilarity read-out, on the families where the two differ. The similarity read-out helps the long-range families and not the bottleneck (barbell) or 1cycle (distance $20>2\cdot 3^L=18$)}{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces \textbf  {$n=20$, mixed training}: same, per seed. Only path\_union and chain\_plus differ at $n=20$ (the cycles and 2chains are too short to exceed the capacity, so both read-outs solve them); the barbell is unsolved by both. Seed $4000$ is an unlucky similarity run.}}{19}{table.caption.34}\protected@file@percent }
\newlabel{tab:simlin_n20}{{20}{19}{\textbf {$n=20$, mixed training}: same, per seed. Only path\_union and chain\_plus differ at $n=20$ (the cycles and 2chains are too short to exceed the capacity, so both read-outs solve them); the barbell is unsolved by both. Seed $4000$ is an unlucky similarity run}{table.caption.34}{}}
\@writefile{toc}{\contentsline {paragraph}{The mechanism, distance by distance.}{19}{section*.35}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Reach by within-component distance on held-out \textbf  {chain\_plus}, $n=40$, mixed training, four seeds. Both curves are non-monotone (worst in the middle, recovering farthest), which is why we report the whole profile, not a single ``reach radius''.}}{19}{table.caption.36}\protected@file@percent }
\newlabel{tab:chainplus_n40}{{21}{19}{Reach by within-component distance on held-out \textbf {chain\_plus}, $n=40$, mixed training, four seeds. Both curves are non-monotone (worst in the middle, recovering farthest), which is why we report the whole profile, not a single ``reach radius''}{table.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Table~\ref {tab:chainplus_n40} drawn out (thick = mean of four seeds, thin = per seed). Linear (red) drops right after $3^L=9$; similarity (blue) holds to $\approx 2\cdot 3^L=18$. Both recover on the farthest pairs.}}{20}{figure.caption.37}\protected@file@percent }
\newlabel{fig:chainplus_n40}{{6}{20}{Table~\ref {tab:chainplus_n40} drawn out (thick = mean of four seeds, thin = per seed). Linear (red) drops right after $3^L=9$; similarity (blue) holds to $\approx 2\cdot 3^L=18$. Both recover on the farthest pairs}{figure.caption.37}{}}
\@writefile{toc}{\contentsline {paragraph}{Confirmed by depth.}{20}{section*.38}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Depth sweep, reach by distance on $n=64$ path-union (seed $1000$). The similarity read-out resolves to $2\cdot 3^L$, double the linear $3^L$, at both depths; bold marks the distances it resolves and linear does not.}}{20}{table.caption.39}\protected@file@percent }
\newlabel{tab:depthsim}{{22}{20}{Depth sweep, reach by distance on $n=64$ path-union (seed $1000$). The similarity read-out resolves to $2\cdot 3^L$, double the linear $3^L$, at both depths; bold marks the distances it resolves and linear does not}{table.caption.39}{}}
\@writefile{toc}{\contentsline {paragraph}{What it cannot fix: the bottleneck.}{20}{section*.40}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The Laplacian-smoothness loss}{20}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces The Laplacian-smoothness loss on the \textbf  {ER} baseline (similarity read-out, $n=20$, exact-match mean over $8$ seeds). A small $\lambda $ helps the long-range connection families and hurts the one needing a \emph  {cut} (2chains). Under mixed training the same comparison is flat ($|\Delta |\le 0.04$).}}{21}{table.caption.41}\protected@file@percent }
\newlabel{tab:lambda}{{23}{21}{The Laplacian-smoothness loss on the \textbf {ER} baseline (similarity read-out, $n=20$, exact-match mean over $8$ seeds). A small $\lambda $ helps the long-range connection families and hurts the one needing a \emph {cut} (2chains). Under mixed training the same comparison is flat ($|\Delta |\le 0.04$)}{table.caption.41}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Two ways to be wrong: under-reaching and over-connecting}{21}{subsection.5.3}\protected@file@percent }
\newlabel{sec:reachcut}{{5.3}{21}{Two ways to be wrong: under-reaching and over-connecting}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {24}{\ignorespaces Reach and cut accuracy, $n=40$, mixed training, mean over four seeds. The similarity read-out improves both on the long families. By contrast the Laplacian loss buys reach by spending cut (ER 2chains: reach $1.00$, cut $0.99\to 0.94$, eight seeds).}}{21}{table.caption.42}\protected@file@percent }
\newlabel{tab:reachcut}{{24}{21}{Reach and cut accuracy, $n=40$, mixed training, mean over four seeds. The similarity read-out improves both on the long families. By contrast the Laplacian loss buys reach by spending cut (ER 2chains: reach $1.00$, cut $0.99\to 0.94$, eight seeds)}{table.caption.42}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}A direct test of the cut: the near-miss probe}{21}{subsection.5.4}\protected@file@percent }
\newlabel{sec:nearmiss}{{5.4}{21}{A direct test of the cut: the near-miss probe}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Near-miss cut test. Solid $=$ cut accuracy vs near-miss distance; dashed $=$ reach vs distance, same axis. Left: $n=40$ mixed (mean of four seeds); right: $n=64$ depth-sweep $L=2$ (one seed). Reach drops sharply at capacity ($9$ linear, $18$ similarity); the cut is a shallow, broad dip with no step there, and the similarity read-out flattens it to $\approx 1.0$.}}{22}{figure.caption.43}\protected@file@percent }
\newlabel{fig:nearmiss}{{7}{22}{Near-miss cut test. Solid $=$ cut accuracy vs near-miss distance; dashed $=$ reach vs distance, same axis. Left: $n=40$ mixed (mean of four seeds); right: $n=64$ depth-sweep $L=2$ (one seed). Reach drops sharply at capacity ($9$ linear, $18$ similarity); the cut is a shallow, broad dip with no step there, and the similarity read-out flattens it to $\approx 1.0$}{figure.caption.43}{}}
\@writefile{toc}{\contentsline {paragraph}{The cut is a mild, broad over-connection, not a second wall.}{22}{section*.44}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}A third failure mode: the degree heuristic --- fixed only by the data}{22}{subsection.5.5}\protected@file@percent }
\newlabel{sec:third}{{5.5}{22}{A third failure mode: the degree heuristic --- fixed only by the data}{subsection.5.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces \textbf  {2cliques}, $n=20$, mean over the eight seeds. The ER/linear baseline fails the easy within-clique $d{=}1$ pairs (the degree heuristic). The similarity read-out --- with or without the Laplacian loss --- fixes that reach but then fails the cut (it over-connects the two cliques), so exact-match stays $0$. Only mixed training solves the whole family, with either read-out: it is fixed by the data, not the head.}}{23}{table.caption.45}\protected@file@percent }
\newlabel{tab:degree}{{25}{23}{\textbf {2cliques}, $n=20$, mean over the eight seeds. The ER/linear baseline fails the easy within-clique $d{=}1$ pairs (the degree heuristic). The similarity read-out --- with or without the Laplacian loss --- fixes that reach but then fails the cut (it over-connects the two cliques), so exact-match stays $0$. Only mixed training solves the whole family, with either read-out: it is fixed by the data, not the head}{table.caption.45}{}}
