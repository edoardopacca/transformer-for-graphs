\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {chain\_plus}: accuracy on connected pairs by distance $d$, $n=20$, linear read-out. Top: eight ER-trained seeds (the wall at $9$ + the recovery, both seed-dependent). Bottom: the mixed-trained model is $\approx 1.00$ everywhere (all eight seeds identical).}}{8}{table.caption.10}\protected@file@percent }
\newlabel{tab:dist_chain_plus}{{2}{8}{\textbf {chain\_plus}: accuracy on connected pairs by distance $d$, $n=20$, linear read-out. Top: eight ER-trained seeds (the wall at $9$ + the recovery, both seed-dependent). Bottom: the mixed-trained model is $\approx 1.00$ everywhere (all eight seeds identical)}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {1chain} (a single path over all nodes), same layout as Table~\ref {tab:dist_chain_plus}. The recovery is weaker here than on chain\_plus.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:dist_1chain}{{3}{8}{\textbf {1chain} (a single path over all nodes), same layout as Table~\ref {tab:dist_chain_plus}. The recovery is weaker here than on chain\_plus}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {path\_union} (a disjoint union of $1$--$4$ random paths), same layout.}}{8}{table.caption.12}\protected@file@percent }
\newlabel{tab:dist_path_union}{{4}{8}{\textbf {path\_union} (a disjoint union of $1$--$4$ random paths), same layout}{table.caption.12}{}}
\@writefile{toc}{\contentsline {paragraph}{The same families at $n=40$, where the capacity is clearly visible.}{8}{section*.13}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {chain\_plus}, $n=40$, linear read-out, accuracy on connected pairs by distance, four seeds each. The mixed model is exactly $1.00$ up to the capacity $9$ and steps down at $10$ (bold) --- the $3^L=9$ wall read directly --- then recovers far out. The ER-trained model has no such step; it is fuzzy at every distance.}}{9}{table.caption.14}\protected@file@percent }
\newlabel{tab:n40_chain_plus}{{5}{9}{\textbf {chain\_plus}, $n=40$, linear read-out, accuracy on connected pairs by distance, four seeds each. The mixed model is exactly $1.00$ up to the capacity $9$ and steps down at $10$ (bold) --- the $3^L=9$ wall read directly --- then recovers far out. The ER-trained model has no such step; it is fuzzy at every distance}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {path\_union}, $n=40$. Same story as chain\_plus: the mixed model steps down exactly at the capacity $9$ (bold) and recovers; the ER model is fuzzy throughout.}}{9}{table.caption.15}\protected@file@percent }
\newlabel{tab:n40_path_union}{{6}{9}{\textbf {path\_union}, $n=40$. Same story as chain\_plus: the mixed model steps down exactly at the capacity $9$ (bold) and recovers; the ER model is fuzzy throughout}{table.caption.15}{}}
\@writefile{toc}{\contentsline {paragraph}{An even sharper wall: 2chains and 1cycle.}{9}{section*.16}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {2chains}, $n=40$ (two disjoint paths of $20$ nodes). The mixed model is a clean step: $1.00$ to the capacity $9$, then $0.00$ (bold), no recovery. The ER model is fuzzy, and seed $4000$ happens to solve it.}}{10}{table.caption.17}\protected@file@percent }
\newlabel{tab:n40_2chains}{{7}{10}{\textbf {2chains}, $n=40$ (two disjoint paths of $20$ nodes). The mixed model is a clean step: $1.00$ to the capacity $9$, then $0.00$ (bold), no recovery. The ER model is fuzzy, and seed $4000$ happens to solve it}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {1cycle}, $n=40$ (one ring $C_{40}$). Same clean step at $9$ for the mixed model. The ER model sits at a seed-dependent floor ($0.14$--$0.78$).}}{10}{table.caption.18}\protected@file@percent }
\newlabel{tab:n40_1cycle}{{8}{10}{\textbf {1cycle}, $n=40$ (one ring $C_{40}$). Same clean step at $9$ for the mixed model. The ER model sits at a seed-dependent floor ($0.14$--$0.78$)}{table.caption.18}{}}
