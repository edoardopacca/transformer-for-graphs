\@writefile{toc}{\contentsline {section}{\numberline {4}Thread 2: the spectral gap --- does a bottleneck add difficulty?}{12}{section.4}\protected@file@percent }
\newlabel{sec:gap}{{4}{12}{Thread 2: the spectral gap --- does a bottleneck add difficulty?}{section.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}The barbell: a bottleneck fails deep inside the capacity}{12}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces \textbf  {barbell}, $n=40$: accuracy on connected pairs by distance, per seed. The mixed model is fine within a clique ($d=1$) but collapses at $d=3$ (bold) --- the bridge --- far inside the capacity $9$. The ER-only model never saw cliques and fails throughout.}}{13}{table.caption.24}\protected@file@percent }
\newlabel{tab:bar_n40}{{12}{13}{\textbf {barbell}, $n=40$: accuracy on connected pairs by distance, per seed. The mixed model is fine within a clique ($d=1$) but collapses at $d=3$ (bold) --- the bridge --- far inside the capacity $9$. The ER-only model never saw cliques and fails throughout}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces \textbf  {barbell}, $n=20$: same. The cliques are larger relative to $n$, so the bridge collapse is at $d\approx 7$--$9$; the mixed model is consistent, the ER model shows the seed lottery.}}{13}{table.caption.25}\protected@file@percent }
\newlabel{tab:bar_n20}{{13}{13}{\textbf {barbell}, $n=20$: same. The cliques are larger relative to $n$, so the bridge collapse is at $d\approx 7$--$9$; the mixed model is consistent, the ER model shows the seed lottery}{table.caption.25}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}barbell\_var: a sweep that turns out not to be about the gap}{13}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces \textbf  {barbell\_var}, $n=20$: exact-match by graph diameter, per seed. Diameter grows as the cliques \emph  {shrink} (the bridge lengthens): $D3$ is two $10$-cliques, $D19$ two $2$-cliques on a long thin bridge. The spectral gap stays $\approx 0.006$--$0.019$ across the whole row, so this is not the gap --- it is the clique density (big dense cliques fail) and the bridge.}}{14}{table.caption.26}\protected@file@percent }
\newlabel{tab:bvdiam_n20}{{14}{14}{\textbf {barbell\_var}, $n=20$: exact-match by graph diameter, per seed. Diameter grows as the cliques \emph {shrink} (the bridge lengthens): $D3$ is two $10$-cliques, $D19$ two $2$-cliques on a long thin bridge. The spectral gap stays $\approx 0.006$--$0.019$ across the whole row, so this is not the gap --- it is the clique density (big dense cliques fail) and the bridge}{table.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces \textbf  {barbell\_var}, $n=40$: same (gap $\approx 0.0008$--$0.005$ throughout). Only the tiniest-clique, longest-bridge case ($D39$, essentially a long sparse path) is ever solved.}}{14}{table.caption.27}\protected@file@percent }
\newlabel{tab:bvdiam_n40}{{15}{14}{\textbf {barbell\_var}, $n=40$: same (gap $\approx 0.0008$--$0.005$ throughout). Only the tiniest-clique, longest-bridge case ($D39$, essentially a long sparse path) is ever solved}{table.caption.27}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}expander\_var: a confounded negative}{14}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces \textbf  {expander\_var}, $n=20$: exact-match by spectral-gap bucket, per seed (higher gap $=$ higher degree $=$ denser). The mixed model solves all; the ER model's rise at small gaps is a real gap effect, its fall at large gaps the density confound.}}{15}{table.caption.28}\protected@file@percent }
\newlabel{tab:expvar}{{16}{15}{\textbf {expander\_var}, $n=20$: exact-match by spectral-gap bucket, per seed (higher gap $=$ higher degree $=$ denser). The mixed model solves all; the ER model's rise at small gaps is a real gap effect, its fall at large gaps the density confound}{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces \textbf  {expander\_var}, $n=40$: same buckets. The ER model's density collapse is sharper than at $n=20$ (it reaches $0$ already by gap $0.3$) and consistent across seeds. The mixed model solves these buckets; its only failure (not shown, a single degree-$2$ graph at gap $<0.04$) is the cycle $C_{40}$ of diameter $20$ --- the capacity wall of Thread~1, not a gap effect.}}{15}{table.caption.29}\protected@file@percent }
\newlabel{tab:expvar_n40}{{17}{15}{\textbf {expander\_var}, $n=40$: same buckets. The ER model's density collapse is sharper than at $n=20$ (it reaches $0$ already by gap $0.3$) and consistent across seeds. The mixed model solves these buckets; its only failure (not shown, a single degree-$2$ graph at gap $<0.04$) is the cycle $C_{40}$ of diameter $20$ --- the capacity wall of Thread~1, not a gap effect}{table.caption.29}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}A confound-free probe: the bottleneck \emph  {can} be isolated, and it matters}{15}{subsection.4.4}\protected@file@percent }
\newlabel{sec:ppclean}{{4.4}{15}{A confound-free probe: the bottleneck \emph {can} be isolated, and it matters}{subsection.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Confound-free parallel-paths probe. \emph  {Model:} the standard \emph  {linear} read-out at $n=40$, ER-trained (top block) and mixed-trained (bottom block). Each number is the \emph  {mean over the four training seeds} of the accuracy on the terminal $(s,t)$ pair (always connected), measured on $400$ freshly-sampled probe graphs per cell. Columns are the fixed distance $\ell $; rows the number of parallel routes $k$ (so resistance $\ell /k$ falls downward). Beyond the capacity ($\ell >9$) a single route fails and more routes rescue it (bold) --- the effective resistance matters at fixed distance. Empty cells do not fit in $n=40$.}}{16}{table.caption.30}\protected@file@percent }
\newlabel{tab:ppclean}{{18}{16}{Confound-free parallel-paths probe. \emph {Model:} the standard \emph {linear} read-out at $n=40$, ER-trained (top block) and mixed-trained (bottom block). Each number is the \emph {mean over the four training seeds} of the accuracy on the terminal $(s,t)$ pair (always connected), measured on $400$ freshly-sampled probe graphs per cell. Columns are the fixed distance $\ell $; rows the number of parallel routes $k$ (so resistance $\ell /k$ falls downward). Beyond the capacity ($\ell >9$) a single route fails and more routes rescue it (bold) --- the effective resistance matters at fixed distance. Empty cells do not fit in $n=40$}{table.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Table~\ref {tab:ppclean} for the mixed model. Each line is a fixed distance $\ell $; the beyond-capacity lines ($\ell =11,13,15$) climb steeply with $k$ --- at the same distance, more parallel routes (lower resistance) make the connection easy.}}{17}{figure.caption.31}\protected@file@percent }
\newlabel{fig:ppclean}{{5}{17}{Table~\ref {tab:ppclean} for the mixed model. Each line is a fixed distance $\ell $; the beyond-capacity lines ($\ell =11,13,15$) climb steeply with $k$ --- at the same distance, more parallel routes (lower resistance) make the connection easy}{figure.caption.31}{}}
