\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Summary of the four diameter-controlled small-model experiments on ER$(n = 40, p = 0.05)$. All runs use $6{,}000{,}000$ training graphs and $500{,}000$ optimisation steps.}}{8}{table.caption.12}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:n40-summary}{{1}{8}{Summary of the four diameter-controlled small-model experiments on ER$(n = 40, p = 0.05)$. All runs use $6{,}000{,}000$ training graphs and $500{,}000$ optimisation steps}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Convergence comparison across the four diameter-controlled experiments. \emph  {Left:} pairwise accuracy as a function of the training step (log scale); boxed labels mark the step at which each model first crosses the $99\%$ threshold (dashed line). \emph  {Right:} per-graph exact-match accuracy on the same log-scaled axis. Despite the large gap in convergence speed, all four runs settle at very similar final values.}}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:n40-convergence}{{7}{8}{Convergence comparison across the four diameter-controlled experiments. \emph {Left:} pairwise accuracy as a function of the training step (log scale); boxed labels mark the step at which each model first crosses the $99\%$ threshold (dashed line). \emph {Right:} per-graph exact-match accuracy on the same log-scaled axis. Despite the large gap in convergence speed, all four runs settle at very similar final values}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {paragraph}{Convergence speed is monotone in the diameter filter.}{8}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Final accuracy is essentially unaffected.}{9}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Cross-experiment view: pairwise accuracy by distance}{9}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Final pairwise accuracy broken down by shortest-path distance $d$ for the four diameter-controlled experiments. Background shading indicates the support of each filtered training distribution. Each curve is truncated at the maximum $d$ present in the corresponding test set.}}{9}{figure.caption.16}\protected@file@percent }
\newlabel{fig:n40-perdistance}{{8}{9}{Final pairwise accuracy broken down by shortest-path distance $d$ for the four diameter-controlled experiments. Background shading indicates the support of each filtered training distribution. Each curve is truncated at the maximum $d$ present in the corresponding test set}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {paragraph}{Accuracy is near-perfect at small distances.}{9}{section*.17}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Restrictive training is worse at the boundary.}{9}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The unfiltered model decays slowly on long-range pairs.}{9}{section*.19}\protected@file@percent }
