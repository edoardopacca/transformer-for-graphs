\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Results}{12}{subsection.7.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Depth sweep ($n = 64$, path-union). The exact-reach threshold (pairwise $\ge 0.99$) sits at \emph  {exactly} $3^L$ for $L = 1, 2$; just past it reach degrades to a partial floor ($\sim 0.8$--$0.9$), not zero. $L \ge 3$ resolves every distance present and is exact.}}{12}{table.caption.45}\protected@file@percent }
\newlabel{tab:reach}{{8}{12}{Depth sweep ($n = 64$, path-union). The exact-reach threshold (pairwise $\ge 0.99$) sits at \emph {exactly} $3^L$ for $L = 1, 2$; just past it reach degrades to a partial floor ($\sim 0.8$--$0.9$), not zero. $L \ge 3$ resolves every distance present and is exact}{table.caption.45}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Pairwise accuracy on within-component pairs vs.\ shortest-path distance $d$, one panel per depth $L$ (test-pair counts above the bars; the red line marks $3^L$). Reach is flat at $1.0$ up to $3^L$, drops sharply at $3^L{+}1$ for $L = 1, 2$, and stays near-perfect across the whole range for $L = 3, 4$.}}{12}{figure.caption.46}\protected@file@percent }
\newlabel{fig:reach-by-distance}{{9}{12}{Pairwise accuracy on within-component pairs vs.\ shortest-path distance $d$, one panel per depth $L$ (test-pair counts above the bars; the red line marks $3^L$). Reach is flat at $1.0$ up to $3^L$, drops sharply at $3^L{+}1$ for $L = 1, 2$, and stays near-perfect across the whole range for $L = 3, 4$}{figure.caption.46}{}}
