\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Reproduction with the minimal (clean A.1-style) architecture: exact-match accuracy at the end of training (3 seeds). In distribution every run is perfect; both OOD families stay near zero, \emph  {including} the diameter-restricted runs. (For reference, 2Chain pairwise accuracy is $\approx 0.99$ and 2Clique pairwise $\approx 0.50$ across all runs.)}}{3}{table.caption.10}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:repro-min}{{1}{3}{Reproduction with the minimal (clean A.1-style) architecture: exact-match accuracy at the end of training (3 seeds). In distribution every run is perfect; both OOD families stay near zero, \emph {including} the diameter-restricted runs. (For reference, 2Chain pairwise accuracy is $\approx 0.99$ and 2Clique pairwise $\approx 0.50$ across all runs.)}{table.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A.1-style model (mean over $3$ seeds): exact-match accuracy vs.\ training step for the unrestricted model on ER (in-distribution), 2Chain and 2Clique. In distribution the model is perfect; the two OOD families stay near zero --- the failure-to-generalise of the paper's Figure~1.}}{3}{figure.caption.11}\protected@file@percent }
\newlabel{fig:repro-fig1}{{1}{3}{A.1-style model (mean over $3$ seeds): exact-match accuracy vs.\^^Mtraining step for the unrestricted model on ER (in-distribution), 2Chain and 2Clique. In distribution the model is perfect; the two OOD families stay near zero --- the failure-to-generalise of the paper's Figure~1}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{What the table and figure show.}{3}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}The RoBERTa-faithful model: the algorithmic solution appears, but the seed decides}{4}{subsection.3.3}\protected@file@percent }
\newlabel{sec:repro-rob}{{3.3}{4}{The RoBERTa-faithful model: the algorithmic solution appears, but the seed decides}{subsection.3.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces RoBERTa-faithful reproduction: final exact-match accuracy, all $8$ seeds per condition. Bold marks runs that ``generalise'' (exact $> 0.5$) on a family. The outcome is bimodal per seed: a run either recovers a strong generalising solution or stays at zero, with little in between, in \emph  {both} conditions.}}{4}{table.caption.13}\protected@file@percent }
\newlabel{tab:repro-rob}{{2}{4}{RoBERTa-faithful reproduction: final exact-match accuracy, all $8$ seeds per condition. Bold marks runs that ``generalise'' (exact $> 0.5$) on a family. The outcome is bimodal per seed: a run either recovers a strong generalising solution or stays at zero, with little in between, in \emph {both} conditions}{table.caption.13}{}}
\@writefile{toc}{\contentsline {paragraph}{One favourable seed looks exactly like the paper.}{4}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Restricted ($D \le 9$, blue) vs.\ unrestricted (orange) training curves for the \emph  {same} seed, RoBERTa-faithful, $n = 20$. Rows: OOD exact-match on 2Chain (top) and 2Clique (bottom); columns: seeds $1000$, $6000$, $7000$. \textbf  {seed 6000:} restriction lifts both families while unrestricted lags --- exactly the paper's Figure~7/11. \textbf  {seed 7000:} reversed --- the unrestricted model generalises and the restricted one stays at zero, i.e.\ the lever \emph  {hurts}. \textbf  {seed 1000:} mixed. Whether the data lever helps is decided by the seed, not by the filter.}}{5}{figure.caption.15}\protected@file@percent }
\newlabel{fig:seed-examples}{{2}{5}{Restricted ($D \le 9$, blue) vs.\ unrestricted (orange) training curves for the \emph {same} seed, RoBERTa-faithful, $n = 20$. Rows: OOD exact-match on 2Chain (top) and 2Clique (bottom); columns: seeds $1000$, $6000$, $7000$. \textbf {seed 6000:} restriction lifts both families while unrestricted lags --- exactly the paper's Figure~7/11. \textbf {seed 7000:} reversed --- the unrestricted model generalises and the restricted one stays at zero, i.e.\ the lever \emph {hurts}. \textbf {seed 1000:} mixed. Whether the data lever helps is decided by the seed, not by the filter}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {paragraph}{The seed, not the filter, is the dominant axis of variation.}{5}{section*.16}\protected@file@percent }
